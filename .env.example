# Docker image to use for Send
# - Latest Send version by @timvisee: registry.gitlab.com/timvisee/send:latest
# - Outdated (archived) Send version by Mozilla: mozilla/send:latest
DOCKER_SEND_IMAGE=registry.gitlab.com/timvisee/send:latest

# Host to expose Send on
HOST=your-domain.com

# Base URL for Send
SEND_BASE_URL=https://your-domain.com

# Optional: for LetsEncrypt SSL, same as HOST
LETSENCRYPT_HOST=your-domain.com

# Optional: for LetsEncrypt SSL, your email address
LETSENCRYPT_EMAIL=your-email@your-domain.com

# Custom branding: logo (mount ./custom_assets into the container)
UI_CUSTOM_ASSETS_ICON=custom_assets/your-logo.svg

# Custom branding: blank 1x1 SVG hides the default wordmark (delete this line if you want to keep default WORDMARK)
UI_CUSTOM_ASSETS_WORDMARK=custom_assets/blank.svg

# Custom footer text and link
CUSTOM_FOOTER_TEXT=
CUSTOM_FOOTER_URL=

# Footer "Source" link — point at your own repository
SEND_FOOTER_SOURCE_URL=
